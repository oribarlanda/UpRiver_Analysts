# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-goes-here

# PINs (server-side only, never exposed to the client).
# Policy: employee PINs must be 6+ digits, the admin PIN must be 8+ digits.
# Choose your own values - do not use these examples in production.
HILA_PIN=384726
YAARA_PIN=592013
OMER_PIN=671459
ADMIN_PIN=48213967

# Session
# Long random string used to sign the session cookie (HMAC-SHA256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Timezone used to determine "today"/"this week" (Sunday-start weeks).
# Defaults to Asia/Jerusalem if not set.
APP_TIME_ZONE=Asia/Jerusalem
